# Public HTTPS origin, without a trailing slash.
PUBLIC_BASE_URL=https://calendar-mcp.example.com
HOST=127.0.0.1
PORT=3000
DEFAULT_TIME_ZONE=Europe/Madrid

# Google Cloud OAuth 2.0 Web application credentials.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me

# Generate both with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key
JWT_SECRET=replace-with-at-least-32-random-bytes

DATABASE_PATH=./data/calendar-mcp.sqlite
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OAUTH_STATE_TTL_SECONDS=600

# Required in production. Exact origins accepted during dynamic client registration.
ALLOWED_REDIRECT_ORIGINS=https://chatgpt.com,https://chat.openai.com

# Strongly recommended for a personal deployment. Empty enables multi-user use.
ALLOWED_GOOGLE_EMAILS=you@example.com
